apiVersion: apps/v1
kind: Deployment
metadata: {name: web, namespace: petclinic}
spec:
  replicas: 2
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app: petclinic-web}}
  template:
    metadata: {labels: {app: petclinic-web}}
    spec:
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 101, runAsGroup: 101, fsGroup: 101, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - {maxSkew: 1, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app: petclinic-web}}}
        - {maxSkew: 1, topologyKey: kubernetes.io/hostname, whenUnsatisfiable: ScheduleAnyway, labelSelector: {matchLabels: {app: petclinic-web}}}
      containers:
        - name: web
          image: '${WEB_IMAGE}'
          ports: [{name: http, containerPort: 8080}]
          resources: {requests: {cpu: 25m, memory: 32Mi}, limits: {cpu: 250m, memory: 96Mi}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          readinessProbe: {httpGet: {path: /, port: http}, periodSeconds: 5}
          livenessProbe: {httpGet: {path: /, port: http}, periodSeconds: 15}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
            - {name: cache, mountPath: /var/cache/nginx}
      volumes:
        - {name: tmp, emptyDir: {}}
        - {name: cache, emptyDir: {}}
---
apiVersion: v1
kind: Service
metadata: {name: web, namespace: petclinic}
spec:
  type: NodePort
  externalTrafficPolicy: Cluster
  selector: {app: petclinic-web}
  ports: [{name: http, port: 8080, targetPort: http, nodePort: 30080}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: api, namespace: petclinic}
spec:
  replicas: 2
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app: petclinic-api}}
  template:
    metadata: {labels: {app: petclinic-api}}
    spec:
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
      topologySpreadConstraints:
        - {maxSkew: 1, topologyKey: topology.kubernetes.io/zone, whenUnsatisfiable: DoNotSchedule, labelSelector: {matchLabels: {app: petclinic-api}}}
        - {maxSkew: 1, topologyKey: kubernetes.io/hostname, whenUnsatisfiable: ScheduleAnyway, labelSelector: {matchLabels: {app: petclinic-api}}}
      containers:
        - name: api
          image: '${API_IMAGE}'
          ports: [{name: http, containerPort: 9966}]
          env:
            - {name: SPRING_PROFILES_ACTIVE, value: external-postgres}
            - {name: POSTGRES_URL, value: 'jdbc:postgresql://${DB_HOST}:5432/petclinic?sslmode=verify-full&sslrootcert=/rds/ca.pem'}
            - {name: POSTGRES_USER, value: petclinic_app}
            - name: POSTGRES_PASS
              valueFrom: {secretKeyRef: {name: petclinic-db-app, key: password}}
            - {name: SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE, value: '4'}
            - {name: MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE, value: 'readinessState,db'}
          resources: {requests: {cpu: 200m, memory: 384Mi}, limits: {cpu: '1', memory: 768Mi}}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          startupProbe: {httpGet: {path: /petclinic/actuator/health/liveness, port: http}, periodSeconds: 5, failureThreshold: 60, timeoutSeconds: 3}
          readinessProbe: {httpGet: {path: /petclinic/actuator/health/readiness, port: http}, periodSeconds: 10, timeoutSeconds: 5}
          livenessProbe: {httpGet: {path: /petclinic/actuator/health/liveness, port: http}, periodSeconds: 15, timeoutSeconds: 3}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
            - {name: ca, mountPath: /rds, readOnly: true}
      volumes:
        - {name: tmp, emptyDir: {}}
        - {name: ca, configMap: {name: rds-ca}}
---
apiVersion: v1
kind: Service
metadata: {name: api, namespace: petclinic}
spec:
  type: NodePort
  externalTrafficPolicy: Cluster
  selector: {app: petclinic-api}
  ports: [{name: http, port: 9966, targetPort: http, nodePort: 30966}]
